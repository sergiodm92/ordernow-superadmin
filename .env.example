# Copiar a .env.local y ajustar los valores:
#   cp .env.example .env.local

# URL base de la API del backend OrderNow (NestJS): incluye el prefijo /api/v1, sin "/" final.
# Es obligatoria: si falta, config/api.axios.ts falla al iniciar con un mensaje explícito
# (no hay valor por defecto, para no hablar con una API equivocada sin enterarse).
# Se expone al navegador (NEXT_PUBLIC_), no poner secretos acá.
# El valor de abajo apunta al backend local (puerto 9091).
NEXT_PUBLIC_API_URL=http://localhost:9091/api/v1
